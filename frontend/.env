# Leave empty to call the API on the same origin (recommended; the dev server proxies /api).
VITE_API_URL=
# Where the Vite dev server forwards /api and /storage during development.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
# Fallback brand name shown before the API config loads. The API value (MARKETPLACE_NAME) wins.
VITE_BRAND_NAME=Betoch Furniture
